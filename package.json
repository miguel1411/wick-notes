{
  "name": "wick-notes",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @wick/db generate && pnpm --parallel --filter @wick/web --filter @wick/collab dev",
    "build": "pnpm --filter @wick/db generate && pnpm --filter @wick/web build && pnpm --filter @wick/cli build",
    "db:migrate": "pnpm --filter @wick/db migrate:dev",
    "db:deploy": "pnpm --filter @wick/db migrate:deploy",
    "test": "pnpm --filter @wick/db generate && pnpm --filter @wick/core --filter @wick/collab --filter @wick/cli --workspace-concurrency=1 test",
    "typecheck": "pnpm -r typecheck",
    "wick": "pnpm --filter @wick/cli --silent dev"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
