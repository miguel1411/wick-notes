generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

model User {
  id           String    @id @default(cuid())
  /// Siempre en minúsculas; es lo que se escribe para iniciar sesión.
  username     String    @unique
  name         String
  passwordHash String
  role         Role      @default(MEMBER)
  /// Las cuentas no se borran (conservan la autoría); se desactivan.
  disabledAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions          Session[]
  apiTokens         ApiToken[]
  documents         Document[]        @relation("DocumentCreatedBy")
  versions          DocumentVersion[]
  workspaces        WorkspaceMember[]
  createdWorkspaces Workspace[]       @relation("WorkspaceCreatedBy")
  moveRequests      MoveRequest[]     @relation("MoveRequestedBy")
  moveDecisions     MoveRequest[]     @relation("MoveDecidedBy")
  aiFolders         AiUserFolder[]
  aiRuns            AiRun[]
  aiSettingsUpdates AiSettings[]
}

enum WorkspaceRole {
  /// Gestiona el espacio (nombre, miembros) además de editar.
  OWNER
  /// Lee y escribe notas y carpetas.
  EDITOR
  /// Solo lee.
  VIEWER
}

/// Espacio de trabajo: agrupa notas y carpetas y define quién puede verlas.
model Workspace {
  id          String            @id @default(cuid())
  name        String
  /// true: cualquier usuario activo es editor aunque no sea miembro (p. ej. «General»).
  everyone    Boolean           @default(false)
  createdById String?
  createdBy   User?             @relation("WorkspaceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  members     WorkspaceMember[]
  folders     Folder[]
  documents   Document[]
  aiFolders   AiUserFolder[]
}

model WorkspaceMember {
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole
  createdAt   DateTime      @default(now())

  @@id([workspaceId, userId])
  @@index([userId])
}

/// Carpeta (anidable) dentro de un espacio de trabajo.
model Folder {
  id          String         @id @default(cuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Folder?        @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Folder[]       @relation("FolderTree")
  name        String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  documents   Document[]
  aiOwners    AiUserFolder[]

  @@index([workspaceId, parentId])
}

model Session {
  /// SHA-256 del token de la cookie. El token en claro nunca se guarda.
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
}

enum TokenScope {
  READ
  WRITE
}

/// Token personal para la API (CLI, MCP, scripts). Solo se guarda su hash.
model ApiToken {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  /// SHA-256 del token completo.
  tokenHash    String        @unique
  /// Primeros caracteres del token, para reconocerlo en la lista.
  prefix       String
  scope        TokenScope
  createdAt    DateTime      @default(now())
  lastUsedAt   DateTime?
  expiresAt    DateTime?
  moveRequests MoveRequest[]

  @@index([userId])
}

model Document {
  id            String            @id @default(cuid())
  title         String
  /// Estado Yjs codificado (Y.encodeStateAsUpdate). Fuente de verdad del contenido.
  yjsState      Bytes?
  /// Texto plano del contenido (derivado de yjsState), para mostrar fragmentos.
  contentText   String            @default("")
  /// contentText en minúsculas y sin tildes: es lo que se compara al buscar.
  contentSearch String            @default("")
  /// Título en minúsculas y sin tildes.
  titleSearch   String            @default("")
  createdById   String?
  createdBy     User?             @relation("DocumentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// Un espacio con notas no se puede borrar (Restrict): primero hay que moverlas o borrarlas.
  workspaceId   String
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  folderId      String?
  folder        Folder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  versions      DocumentVersion[]
  moveRequests  MoveRequest[]
  aiRuns        AiRun[]

  @@index([updatedAt])
  @@index([workspaceId, folderId])
}

enum MoveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  /// Aprobada, pero no se pudo mover (p. ej. la carpeta ya no existe).
  FAILED
  /// Sustituida por otra solicitud más reciente para la misma nota.
  SUPERSEDED
}

/// Un agente (token de API) propone mover una nota; una persona la aprueba en la web.
model MoveRequest {
  id                String            @id @default(cuid())
  documentId        String
  document          Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  requestedById     String
  requestedBy       User              @relation("MoveRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  /// Token con el que se pidió (el agente); null si se revocó.
  tokenId           String?
  token             ApiToken?         @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  targetWorkspaceId String
  /// null = raíz del espacio.
  targetFolderId    String?
  /// Por qué lo propone el agente.
  reason            String?
  status            MoveRequestStatus @default(PENDING)
  decidedById       String?
  decidedBy         User?             @relation("MoveDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt         DateTime?
  error             String?
  createdAt         DateTime          @default(now())

  @@index([requestedById, status])
  @@index([documentId, status])
}

enum VersionReason {
  /// Mientras se edita (como mucho una cada pocos minutos).
  AUTO
  /// Guardada a mano por alguien.
  MANUAL
  /// Justo antes de que la API, la CLI o un agente reemplazaran el contenido.
  BEFORE_REPLACE
  /// Justo antes de restaurar otra versión.
  BEFORE_RESTORE
}

/// Instantánea completa de una nota en un momento dado.
model DocumentVersion {
  id          String        @id @default(cuid())
  documentId  String
  document    Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// Título de la nota en ese momento.
  title       String
  yjsState    Bytes
  contentText String        @default("")
  reason      VersionReason
  /// Quién hizo los últimos cambios (o quién guardó la versión).
  authorId    String?
  author      User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  @@index([documentId, createdAt])
}

// ------------------------------------------------------------ IA (opcional)

/// Ajustes de la IA de la instancia (una sola fila, id «instance»). Se cambian desde la web.
model AiSettings {
  id              String   @id @default("instance")
  /// Apagada, la función no aparece y la API la rechaza.
  enabled         Boolean  @default(false)
  provider        String   @default("anthropic")
  /// Clave de API cifrada (AES-256-GCM, ver core/ai/secret.ts). Nunca en claro.
  apiKeyEncrypted String?
  /// Últimos caracteres de la clave, para reconocerla en la web.
  apiKeyHint      String?
  model           String   @default("claude-opus-5-5")
  /// ¿Se permite investigar en internet?
  webSearch       Boolean  @default(true)
  maxSearches     Int      @default(5)
  /// Notas con IA por usuario y día.
  dailyLimit      Int      @default(10)
  updatedAt       DateTime @updatedAt
  updatedById     String?
  updatedBy       User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

/// Carpeta donde se guardan las notas con IA de cada usuario en cada espacio.
/// Si la carpeta se borra, la fila desaparece (Cascade) y se crea otra.
model AiUserFolder {
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folderId    String    @unique
  folder      Folder    @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([userId, workspaceId])
}

enum AiRunStatus {
  /// En curso: reserva el cupo del día mientras se crea la nota.
  PENDING
  /// Se creó la nota.
  CREATED
  /// Se rechazó antes de redactar (p. ej. una foto no está escrita a mano).
  REJECTED
  /// Falló (proveedor, rechazo de seguridad, error interno).
  FAILED
}

/// Registro de cada uso de la IA: para el límite diario y para conocer el costo.
/// Sin imágenes ni contenido.
model AiRun {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId  String
  documentId   String?
  document     Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)
  provider     String
  model        String
  status       AiRunStatus
  images       Int
  inputTokens  Int         @default(0)
  outputTokens Int         @default(0)
  webSearches  Int         @default(0)
  /// Motivo del rechazo o del fallo (texto corto, sin contenido de la nota).
  error        String?
  createdAt    DateTime    @default(now())

  @@index([userId, createdAt])
}
