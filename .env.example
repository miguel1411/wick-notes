# --- Base de datos ---
POSTGRES_USER=wick
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wick_notes
# Puerto de PostgreSQL publicado en el host (solo para desarrollo).
POSTGRES_PORT=5433

# Conexión usada en desarrollo (pnpm dev / pnpm test) desde el host.
# Dentro de Docker Compose se construye automáticamente con el host "postgres".
DATABASE_URL=postgresql://wick:change-me@localhost:5433/wick_notes

# --- Puertos publicados ---
WEB_PORT=3120
COLLAB_PORT=3121

# URL del WebSocket de colaboración vista desde el navegador.
# Vacío = mismo host que la web, puerto COLLAB_PORT (sirve en LAN sin configurar nada).
NUXT_PUBLIC_COLLAB_URL=
NUXT_PUBLIC_COLLAB_PORT=3121

# Código fuente de esta instalación, enlazado desde la app («Código fuente»).
# Vacío = el repositorio oficial. La licencia (AGPL-3.0) pide ofrecer el código
# a quien use por red una versión modificada: si cambias wick notes, pon aquí tu copia.
NUXT_PUBLIC_SOURCE_URL=

# true solo si hay un proxy inverso delante (usa sus cabeceras X-Forwarded-*).
NUXT_TRUST_PROXY=false

# Interfaz donde se publican web y colaboración. 127.0.0.1 = solo esta máquina.
# 0.0.0.0 = toda la red. Crea el admin antes de abrirlo a la red.
BIND_ADDRESS=127.0.0.1

# Solo desarrollo (pnpm dev): interfaz donde escuchan web y colaboración.
# Vacío = 127.0.0.1. Ejemplo: la IP de Tailscale de este servidor, para abrirlo
# desde tus otros equipos de la tailnet sin exponerlo a la red local.
DEV_HOST=

# Tamaño de página de los PDF exportados: a4 o us-letter (carta).
NUXT_PDF_PAPER=a4
